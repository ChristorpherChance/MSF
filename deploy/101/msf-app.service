[Unit]
Description=MSF 软件工厂 101 本机部署实例（web 静态 + /api 同端口 18920，LAN 直访）
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=superopen
EnvironmentFile=/home/superopen/All-Projects/msf/deploy/101/msf-app.env
WorkingDirectory=/home/superopen/All-Projects/msf/apps/server
ExecStart=/home/superopen/opt/node22/bin/node dist/main.js
Restart=on-failure
RestartSec=3
# 日志：journalctl -u msf-app -f

[Install]
WantedBy=multi-user.target
