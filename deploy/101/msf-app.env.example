# MSF 101 本机部署实例环境变量模板——真实文件由部署脚本生成于同目录 msf-app.env（600，不进 git）
# 供 systemd msf-app.service 使用（EnvironmentFile）；与 dev 用的 msf.env 分开（dev 不设 MSF_PORT，
# 否则 nest watch 会占 18920、vite 代理 8080 落空）。
MSF_PORT=18920
MSF_WEB_DIST=/home/superopen/All-Projects/msf/apps/web/dist
# 浏览器在 Windows 管理机、MinIO 只绑 127.0.0.1——必须开应用内文件代理
MSF_FILES_PROXY=1
# 数据库/MinIO/密钥根沿用仓库 dev 默认值（pg msf/msf、minio msf/msfsecret、缺省密钥根）；
# 登录门不设（LAN 内零鉴权，与 dev 口径一致）
