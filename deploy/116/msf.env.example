# MSF 116 部署环境变量模板——真实文件由部署脚本生成于同目录 msf.env（600 权限，不进 git）
# 占位符 <...> 在部署时替换为强随机值/实值
MSF_PORT=18920
MSF_DATABASE_URL=postgres://msf:<PG密码>@127.0.0.1:5432/msf
MSF_REDIS_URL=redis://127.0.0.1:6379
MSF_MINIO_ENDPOINT=127.0.0.1
MSF_MINIO_PORT=9000
MSF_MINIO_ACCESS_KEY=<MINIO_ACCESS>
MSF_MINIO_SECRET_KEY=<MINIO_SECRET>
MSF_MINIO_BUCKET=msf-artifacts
MSF_SECRET_KEY=<64位强随机>
MSF_AUTH_USER=superopen
MSF_AUTH_PASS=<登录口令>
MSF_WEB_DIST=/home/superopen/All-Projects/msf/apps/web/dist
MSF_AI_PROVIDER=pi
# 沙箱镜像锚定清单（与本地一致；digest 锚定防漂移）
MSF_SANDBOX_IMAGES=[{"tag":"alpine:3.20","digest":"sha256:bf8527eb54c3680e728d5b4b383a8ba730d72dae7236fbc8dff97ed6b224a731"}]
